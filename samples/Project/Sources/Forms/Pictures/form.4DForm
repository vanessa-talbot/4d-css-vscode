{
	"$4d": {
		"version": "1",
		"kind": "form"
	},
	"windowTitle": "Picture paths",
	"destination": "detailScreen",
	"pages": [
		{
			"objects": {}
		},
		{
			"objects": {
				"iconFromResources": {
					"type": "button",
					"text": "Icon from /RESOURCES/",
					"top": 20,
					"left": 20,
					"width": 200,
					"height": 26,
					"icon": "/RESOURCES/Images/Test/contact_icon_glass.svg",
					"textPlacement": "right"
				},
				"iconMissing": {
					"type": "button",
					"text": "Missing icon",
					"top": 20,
					"left": 240,
					"width": 200,
					"height": 26,
					"icon": "/RESOURCES/Images/Test/missing_icon.svg",
					"textPlacement": "right"
				},
				"backgroundFromResources": {
					"type": "button",
					"text": "Custom background",
					"top": 60,
					"left": 20,
					"width": 100,
					"height": 26,
					"style": "custom",
					"customBackgroundPicture": "/RESOURCES/Images/Test/bg4states_rect.svg"
				},
				"backgroundMissing": {
					"type": "button",
					"text": "Missing background",
					"top": 60,
					"left": 240,
					"width": 100,
					"height": 26,
					"style": "custom",
					"customBackgroundPicture": "/RESOURCES/Images/Test/bg_missing.svg"
				},
				"pictureFromFormFolder": {
					"type": "picture",
					"top": 100,
					"left": 20,
					"width": 64,
					"height": 64,
					"picture": "logo.svg",
					"pictureFormat": "scaled"
				},
				"pictureMissing": {
					"type": "picture",
					"top": 100,
					"left": 240,
					"width": 64,
					"height": 64,
					"picture": "Images/logo.png",
					"pictureFormat": "scaled"
				},
				"pictureFromVariable": {
					"type": "picture",
					"top": 180,
					"left": 20,
					"width": 64,
					"height": 64,
					"picture": "var:vLogo",
					"pictureFormat": "scaled"
				}
			}
		}
	]
}
