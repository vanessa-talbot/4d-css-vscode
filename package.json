{
  "name": "4d-css-language-support",
  "displayName": "4D Form & CSS Language Support",
  "description": "Syntax highlighting, completion and diagnostics for 4D form style sheets and .4DForm files, driven by the 4D Forms JSON Schema.",
  "version": "0.2.1",
  "publisher": "vanessa-talbot",
  "icon": "resources/icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/vanessa-talbot/4d-css-vscode.git"
  },
  "bugs": {
    "url": "https://github.com/vanessa-talbot/4d-css-vscode/issues"
  },
  "homepage": "https://github.com/vanessa-talbot/4d-css-vscode#readme",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "keywords": [
    "4D",
    "4DForm",
    "form",
    "style sheet",
    "css"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "4d-css",
        "aliases": [
          "4D CSS",
          "4D Form CSS"
        ],
        "extensions": [
          ".4dcss"
        ],
        "filenames": [
          "styleSheets.css",
          "styleSheets_mac.css",
          "styleSheets_windows.css"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "json",
        "extensions": [
          ".4DForm"
        ]
      }
    ],
    "grammars": [
      {
        "language": "4d-css",
        "scopeName": "source.4dcss",
        "path": "./syntaxes/4dcss.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "4D CSS",
      "properties": {
        "4dCss.schemaPath": {
          "type": "string",
          "default": "",
          "description": "Optional path to a custom 4D Forms JSON Schema. Leave empty to use the bundled schema."
        }
      }
    },
    "commands": [
      {
        "command": "4dCss.showDocumentation",
        "title": "4D CSS: Show Reference"
      },
      {
        "command": "4dCss.reloadSchema",
        "title": "4D CSS: Reload Schema"
      },
      {
        "command": "4dCss.validateWorkspace",
        "title": "4D CSS: Validate All Form and Style Sheet Files"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "4dCss",
          "title": "4D CSS",
          "icon": "./resources/4d-css.svg"
        }
      ]
    },
    "views": {
      "4dCss": [
        {
          "type": "webview",
          "id": "4dCss.documentation",
          "name": "Reference",
          "icon": "./resources/4d-css.svg"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p ./tsconfig.json",
    "watch": "tsc -watch -p ./tsconfig.json",
    "package": "npm run compile && npx vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.1.0",
    "typescript": "^5.5.4"
  },
  "dependencies": {
    "jsonc-parser": "^3.3.1"
  }
}
